{
  "name": "fotd",
  "lovefile": "FotD",
  "version": "1.0.0",
  "private": true,
  "description": "Fear of the Dark  --  retro top-down RPG built with Lua and LOVE2D",
  "scripts": {
    "setup": "npm install && node src/love2d4me/scripts/setup-love.js",
    "lint": "node src/love2d4me/scripts/lint-vars.js src",
    "start": "node src/love2d4me/scripts/start.js",
    "dev": "node src/love2d4me/scripts/dev.js",
    "pack": "node src/love2d4me/scripts/pack-love.js",
    "build": "npm run pack && love.js FotD.love Web -t \"Fear of the Dark\" && node src/love2d4me/scripts/patch-web.js",
    "serve": "npx --yes http-server Web -p 8080 -c-1"
  },
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "love.js": "^11.4.1"
  }
}
